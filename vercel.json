{
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/treasury/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.py": {
      "excludeFiles": "{frontend/**,node_modules/**,packages/auth/node_modules/**,docs/**,backend/tests/**}"
    }
  },
  "build": {
    "env": {
      "VERCEL_SUPPORT_LARGE_FUNCTIONS": "1"
    }
  }
}
