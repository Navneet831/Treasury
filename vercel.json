{
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/treasury/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.py": {
      "excludeFiles": "{frontend,node_modules,packages/auth/node_modules,.git,docs,other,backend/tests}/**"
    }
  }
}
