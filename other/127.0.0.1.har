            "text": "import { createHotContext as __vite__createHotContext } from \"/@vite/client\";import.meta.hot = __vite__createHotContext(\"/src/domains/utilization/LimitUtilization.tsx\");import __vite__cjsImport0_react_jsxDevRuntime from \"/node_modules/.vite/deps/react_jsx-dev-runtime.js?v=e14facae\"; const Fragment = __vite__cjsImport0_react_jsxDevRuntime[\"Fragment\"]; const jsxDEV = __vite__cjsImport0_react_jsxDevRuntime[\"jsxDEV\"];\nimport * as RefreshRuntime from \"/@react-refresh\";\nconst inWebWorker = typeof WorkerGlobalScope !== \"undefined\" && self instanceof WorkerGlobalScope;\nlet prevRefreshReg;\nlet prevRefreshSig;\nif (import.meta.hot && !inWebWorker) {\n  if (!window.$RefreshReg$) {\n    throw new Error(\n      \"@vitejs/plugin-react can't detect preamble. Something is wrong.\"\n    );\n  }\n  prevRefreshReg = window.$RefreshReg$;\n  prevRefreshSig = window.$RefreshSig$;\n  window.$RefreshReg$ = RefreshRuntime.getRefreshReg(\"D:/tmp/Treasury/frontend/src/domains/utilization/LimitUtilization.tsx\");\n  window.$RefreshSig$ = RefreshRuntime.createSignatureFunctionForTransform;\n}\nvar _s = $RefreshSig$(), _s2 = $RefreshSig$();\nimport __vite__cjsImport3_react from \"/node_modules/.vite/deps/react.js?v=e14facae\"; const React = __vite__cjsImport3_react.__esModule ? __vite__cjsImport3_react.default : __vite__cjsImport3_react; const useEffect = __vite__cjsImport3_react[\"useEffect\"]; const useState = __vite__cjsImport3_react[\"useState\"]; const useCallback = __vite__cjsImport3_react[\"useCallback\"]; const useRef = __vite__cjsImport3_react[\"useRef\"];\nimport { getLimitUtilisation, getCommandData, getDrillDown } from \"/src/api.ts\";\nimport DrillDownModal from \"/src/components/DrillDownModal.tsx\";\nimport ProvenanceBadge from \"/src/components/ProvenanceBadge.tsx\";\nimport { useStore } from \"/src/store.ts\";\nimport { formatCurrencyCompact, formatPercent } from \"/src/utils.ts\";\nimport {\n  Gauge,\n  RefreshCw,\n  Clock,\n  Shield,\n  C